# Vercel API 使用：开启 Connection pooling，主机名通常包含 -pooler。
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# 本地建表和批量导入使用：关闭 Connection pooling。
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DB?sslmode=require

# Vercel 服务端生成问题向量；Token 需要 Inference Providers 权限。
HF_TOKEN=hf_your_token
